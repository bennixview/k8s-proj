{
  "version": 3,
  "name": "KrakenD API Gateway",
  "port": 8080,
  "cache_ttl": "3600s",
  "timeout": "3s",
  "endpoints": [
    {
      "endpoint": "/hello",
      "method": "GET",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/hello",
          "encoding": "json",
          "host": ["http://nodejs-app:3000"],
          "method": "GET"
        }
      ]
    }
  ]
}