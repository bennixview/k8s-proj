{
  "version": 3,
  "name": "KrakenD API Gateway",
  "port": 8080,
  "cache_ttl": "3600s",
  "timeout": "3s",
  "endpoints": [
    {
      "endpoint": "/hello",
      "method": "GET",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/hello",
          "encoding": "json",
          "host": ["http://nodejs-app:3000"],
          "querystring_params" : [
            {
              "name": "name",
              "description": "Name of the person to greet",
              "required": false,
              "type": "string"
            }
          ],
          "method": "GET"
        }
      ]
    },
    {
      "endpoint": "/ui",
      "method": "GET",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/",
          "encoding": "no-op",
          "host": ["http://remix-ui:3000"],
          "method": "GET"
        }
      ]
    },
    {
      "endpoint": "/ui/{path}",
      "method": "GET",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/{path}",
          "encoding": "no-op",
          "host": ["http://remix-ui:3000"],
          "method": "GET"
        }
      ]
    },
    {
      "endpoint": "/build/{path}",
      "method": "GET",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/build/{path}",
          "encoding": "no-op",
          "host": ["http://remix-ui:3000"],
          "method": "GET"
        }
      ]
    },
    {
      "endpoint": "/resources/{path}",
      "method": "GET",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/resources/{path}",
          "encoding": "no-op",
          "host": ["http://remix-ui:3000"],
          "method": "GET"
        }
      ]
    }
  ]
}